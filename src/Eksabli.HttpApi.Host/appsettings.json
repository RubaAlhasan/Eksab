{
  "App": {
    "SelfUrl": "https://localhost:44330",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "https://*.Eksabli.com,http://localhost:4200,",
    "RedirectAllowedUrls": "http://localhost:4200,",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=Eksabli;User Id=postgres;Password=123"
  },
  "AuthServer": {
    "Authority": "https://localhost:44330",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "Eksabli_Swagger",
    "CertificatePassPhrase": "a8a5c4df-3387-44f7-b368-e21f3f0b2f4e"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "JjmQeaX2m67PuC5g"
  },
  "OpenIddict": {
    "Applications": {
      "Eksabli_App": {
        "ClientId": "Eksabli_App",
        "RootUrl": "http://localhost:4200"
      },
      "Eksabli_Swagger": {
        "ClientId": "Eksabli_Swagger",
        "RootUrl": "https://localhost:44330/"
      }
    }
  }

}