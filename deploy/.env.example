# Copy to .env and fill in. .env is gitignored -- never commit real values.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
# LOCAL REHEARSAL (Docker Desktop). Add both names to
# C:\Windows\System32\drivers\etc\hosts pointing at 127.0.0.1 -- do not use bare
# "localhost", the API and the SPA need distinct origins for CORS to mean anything.
API_DOMAIN=api.eksabli.local
API_URL=http://api.eksabli.local
APP_URL=http://app.eksabli.local
NGINX_CONF=./nginx/api.local.conf

# NGINX_CONF only matters when the stack is started with `--profile nginx`. On a host that
# already runs a reverse proxy -- e.g. the Traefik that ships with Hostinger's Docker template,
# which owns :80/:443 and issues its own Let's Encrypt certificates -- the api service is routed
# by the traefik.* labels in docker-compose.yml instead, and nginx/certbot are not started.

# Rehearsal runs on plain HTTP, so OpenIddict's transport-security check has to be relaxed
# and verbose identity logging is harmless.
AUTH_REQUIRE_HTTPS=false
APP_DISABLE_PII=false

# PRODUCTION (Hostinger VPS) -- swap the six lines above for these:
#   API_DOMAIN=api.example.com
#   API_URL=https://api.example.com
#   APP_URL=https://app.example.com
#   NGINX_CONF=./nginx/api.prod.conf
#   AUTH_REQUIRE_HTTPS=true      # keep true; plain-HTTP tokens would otherwise be accepted
#   APP_DISABLE_PII=true         # stops tokens and user ids being written to the log file

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_DB=Eksabli
POSTGRES_USER=eksabli
POSTGRES_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Secrets -- all three are CHANGE_ME on purpose
# ---------------------------------------------------------------------------
# Passphrase for secrets/openiddict.pfx. Generate a FRESH certificate rather than reusing
# the repo-root one: that file is gitignored (so the key itself never leaked), but the
# passphrase protecting it IS committed in appsettings.json, and it is a dev certificate.
#   openssl rand -base64 24
OPENIDDICT_PFX_PASSWORD=CHANGE_ME

# ABP encrypts some stored settings with this. Changing it later makes previously
# encrypted rows unreadable, so pick once and keep it in a password manager.
# (appsettings.json ships a 16-char default; longer is fine.)
STRING_ENCRYPTION_PASSPHRASE=CHANGE_ME
