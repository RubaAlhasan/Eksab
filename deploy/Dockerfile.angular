# Multi-stage build for the Angular SPA.
#
# Build context is the REPOSITORY ROOT (compose sets `context: ..`), so paths below are
# prefixed with angular/.
#
# This replaces angular/Dockerfile, the stock ABP template file, which has two problems:
#   1. `COPY package*.json` matches package.json and package-lock.json but NOT yarn.lock,
#      so the `yarn` that follows resolved fresh versions on every build -- the lockfile was
#      copied in later, by `COPY . /app`, long after install had already happened.
#   2. No .dockerignore, so a local node_modules/ was copied into the context.
# That file is left in place for ABP Studio's tooling.

FROM node:20-alpine AS build
WORKDIR /app

# Both manifests, before the sources, so the dependency layer caches on lockfile changes only.
COPY angular/package.json angular/yarn.lock ./
RUN yarn install --frozen-lockfile

COPY angular/ ./

# Angular 21 production builds are memory-hungry; the default heap is too small on a 2-vCPU box.
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN yarn build:prod

FROM nginx:alpine
# Serves the SPA with try_files -> /index.html, and /getEnvConfig -> dynamic-env.json.
COPY angular/nginx.conf /etc/nginx/conf.d/default.conf
# Angular 17+ emits under dist/<name>/browser/.
COPY --from=build /app/dist/Eksabli/browser /usr/share/nginx/html

# dynamic-env.json is bind-mounted at runtime, NOT baked in: it carries the API URL, which
# differs per environment. environment.prod.ts declares remoteEnv /getEnvConfig with a
# deepmerge strategy, so what this file contains overrides the compiled-in localhost values --
# which is why the image is environment-agnostic and needs no rebuild per deployment.
